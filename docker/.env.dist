# Canary Kotlin quickstart configuration (adapted from canary/docker/.env.dist).
#
# Copy to the repository root before running Docker Compose:
#   cp docker/.env.dist .env
#
# The public contract is the CANARY_* prefix. Every variable is optional; the
# defaults below are the local-development values.

# --- Database (PostgreSQL 16) ---
CANARY_DB_NAME=canary
CANARY_DB_USER=canary
CANARY_DB_PASSWORD=canary
# Host port exposed for the database container (internal port is always 5432).
CANARY_DB_PORT=5432

# --- Server identity ---
# Address advertised to clients in the character/world list. For local
# quickstart, 127.0.0.1 points the client back to the host machine.
CANARY_SERVER_NAME=Canary Kotlin Server
CANARY_IP=127.0.0.1

# --- Ports ---
# Login/status and game-world ports (must match the client configuration).
CANARY_LOGIN_PORT=7171
CANARY_GAME_PORT=7172
CANARY_STATUS_PORT=7171

# --- RSA handshake (optional) ---
# Override the built-in OpenTibia key pair with your own decimal p/q primes.
# Both must be set together or the server refuses to boot.
#CANARY_RSA_P=
#CANARY_RSA_Q=

# --- Metrics (optional) ---
# Prometheus exporter; see metrics/README.md for the full stack.
CANARY_METRICS_ENABLE_PROMETHEUS=false
CANARY_METRICS_PROMETHEUS_ADDRESS=0.0.0.0:9464
# Host port published for the exporter (only serves when enabled above).
CANARY_METRICS_PORT=9464

# --- Upstream quickstart extras (NOT used by this stack) ---
# Upstream Canary's quickstart also ships MyAAC (website/admin, MySQL-only) and
# opentibiabr/login-server. This port logs in natively on CANARY_LOGIN_PORT and
# runs on PostgreSQL; see docker/DOCKER.md for the mapping and rationale.
