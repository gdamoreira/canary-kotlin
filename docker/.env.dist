# Canary Kotlin quickstart configuration (adapted from canary/docker/.env.dist).
#
# Copy to the repository root before running Docker Compose:
#   cp docker/.env.dist .env
#
# The public contract is the CANARY_* prefix. Every variable is optional; the
# defaults below are the local-development values.

# --- Database (PostgreSQL 16 by default; MariaDB 11.4 optional) ---
# Engine selector read by the server: postgres|postgresql (default) or
# maria|mariadb|mysql. The base stack uses it with the Postgres `db` service;
# to run the whole stack on MariaDB use the compose override, which pins the
# engine/host/port itself (see docker/DOCKER.md "Database engines"):
#   docker compose -f docker-compose.yml -f docker/docker-compose.mariadb.yml up -d --build
CANARY_DB_ENGINE=postgres
CANARY_DB_NAME=canary
CANARY_DB_USER=canary
CANARY_DB_PASSWORD=canary
# Host port exposed for the PostgreSQL container (internal port is always 5432;
# MariaDB mode connects to mariadb:3306 inside the network).
CANARY_DB_PORT=5432

# --- Server identity ---
# Address advertised to clients in the character/world list. For local
# quickstart, 127.0.0.1 points the client back to the host machine.
CANARY_SERVER_NAME=Canary Kotlin Server
CANARY_IP=127.0.0.1

# --- Ports ---
# Login/status and game-world ports (must match the client configuration).
CANARY_LOGIN_PORT=7171
CANARY_GAME_PORT=7172
CANARY_STATUS_PORT=7171

# --- RSA handshake (optional) ---
# Override the built-in OpenTibia key pair with your own decimal p/q primes.
# Both must be set together or the server refuses to boot.
#CANARY_RSA_P=
#CANARY_RSA_Q=

# --- Metrics (optional) ---
# Prometheus exporter; see metrics/README.md for the full stack.
CANARY_METRICS_ENABLE_PROMETHEUS=false
CANARY_METRICS_PROMETHEUS_ADDRESS=0.0.0.0:9464
# Host port published for the exporter (only serves when enabled above).
CANARY_METRICS_PORT=9464

# Root password for the MariaDB service. By default it backs the upstream
# MyAAC website and opentibiabr/login-server (both MySQL-only); in MariaDB
# single-DB mode it is also the game database.
CANARY_DB_ROOT_PASSWORD=root

# --- Server location (status/webservice metadata) ---
CANARY_SERVER_LOCATION=BRA

# --- MyAAC website/admin (upstream component, MySQL-only) ---
MYAAC_HTTP_PORT=8080
MYAAC_SITE_URL=http://localhost:8080
MYAAC_REF=2.x
MYAAC_ADMIN_ACCOUNT=myaacadmin
MYAAC_ADMIN_EMAIL=admin@localhost.local
MYAAC_ADMIN_PASSWORD=admin123
MYAAC_ADMIN_PLAYER=ADM1
MYAAC_CLIENT_VERSION=1513
MYAAC_TIMEZONE=America/Fortaleza

# --- opentibiabr/login-server (upstream client login webservice, MySQL-only) ---
LOGIN_SERVER_IMAGE=opentibiabr/login-server:latest
LOGIN_HTTP_PORT=8088
LOGIN_GRPC_PORT=9090
LOGIN_RATE_LIMITER_RATE=2
LOGIN_RATE_LIMITER_BURST=5
