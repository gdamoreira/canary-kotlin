# syntax=docker/dockerfile:1.7
#
# ARM64 (linux/arm64) server image, adapted from canary/docker/Dockerfile.arm.
# The JVM distribution is platform-neutral; this file pins the build and the
# runtime to arm64 for hosts that need an explicit architecture.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.arm -t canary-kotlin:arm .
FROM --platform=linux/arm64 gradle:9.8.1-jdk25 AS build
WORKDIR /app
COPY . .
RUN gradle installDist --no-daemon

FROM --platform=linux/arm64 eclipse-temurin:25-jre-alpine
WORKDIR /app
COPY --from=build /app/build/install/canary-kotlin /app
EXPOSE 7171 7172 9464
ENTRYPOINT ["/app/bin/canary-kotlin"]
